{
  "mcpServers": {
    "db": {
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:fake-password@localhost:5432/exampledb"
      ]
    },
    "gh": {
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "fs": {
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "browser": {
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp"
      ]
    },
    "context": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}
