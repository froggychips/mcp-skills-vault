{
  "mcpServers": {
    "docs": {
      "type": "http",
      "url": "https://mcp.example.com/docs"
    },
    "context": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "browser": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  }
}
