.DS_Store
.vscode/
.idea/
node_modules/
*.log
.env
.env.local
__pycache__/
*.pyc

# `mcp-vault lock --vendor` installs locked trees here. Committing them is a
# deliberate choice (a vendored tree is reproducible but large), not a default.
.mcp-vault/

# The DB signature is made at release time (release.yml → sign_db.cjs) and
# ships in the npm tarball. A copy committed here would go stale on the next DB
# change and read as tampering.
mcp-ecosystem-intelligence/assets/*.sig

# Built by `mcp-vault site-registry` / `mcp-vault badge --write`. The public
# site is assembled in froggychips/mcp-site from the npm release; the vault
# does not commit its own generated output.
docs/site/badges/
docs/site/entry/

# The sub-registry export (`mcp-vault export-registry`) is built by the site
# repo (froggychips/mcp-site) from the npm release, not committed here.
docs/site/v0.1/
