{
  "name": "@froggychips/mcp-vault",
  "version": "0.16.0",
  "description": "Offline security check for MCP configs in CI. A GitHub Action, pre-commit hook and CLI that flag unpinned MCP servers, plaintext secrets, typosquats, tool poisoning and toxic tool flows — offline, zero dependencies, no telemetry.",
  "bin": {
    "mcp-vault": "bin/mcp-vault.cjs",
    "mcp-vault-pre-commit": "bin/mcp-vault-pre-commit.cjs"
  },
  "files": [
    "bin",
    "mcp-ecosystem-intelligence/scripts",
    "mcp-ecosystem-intelligence/assets/tools_database.json",
    "mcp-ecosystem-intelligence/assets/tools_database.json.sig",
    "mcp-ecosystem-intelligence/assets/trusted_keys.json",
    "mcp-ecosystem-intelligence/assets/eval_results.json",
    "mcp-ecosystem-intelligence/assets/capabilities.json",
    "mcp-ecosystem-intelligence/assets/mcp-wrapper-template",
    "mcp-ecosystem-intelligence/SKILL.md",
    "docs/COMPATIBILITY.md",
    "PHILOSOPHY.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "verify": "node bin/mcp-vault.cjs verify --offline --fail-families integrity,pin,oci,verify,policy",
    "site:registry": "node mcp-ecosystem-intelligence/scripts/generate_registry_page.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/froggychips/mcp-skills-vault.git"
  },
  "homepage": "https://mcp.froggychips.xyz",
  "bugs": {
    "url": "https://github.com/froggychips/mcp-skills-vault/issues"
  },
  "author": "froggychips",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-security",
    "claude-code",
    "cursor",
    "vscode",
    "github-action",
    "pre-commit",
    "ci",
    "supply-chain-security",
    "secret-scanning",
    "typosquatting",
    "prompt-injection",
    "tool-poisoning",
    "sarif",
    "security",
    "offline-first",
    "devsecops"
  ],
  "publishConfig": {
    "access": "public"
  }
}
